{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "scr-community",
  "main": "worker/index.ts",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"],
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "scr-community",
      "database_id": "7524114b-d0b7-4e3a-8602-86ff7569c64f",
      "migrations_dir": "migrations",
    },
  ],
  "r2_buckets": [{ "binding": "FILES", "bucket_name": "scr-community-files" }],
  "ai": { "binding": "AI" },
  "ratelimits": [
    {
      "name": "API_RATE_LIMITER",
      "namespace_id": "51001",
      "simple": { "limit": 300, "period": 60 },
    },
    {
      "name": "AUTH_RATE_LIMITER",
      "namespace_id": "51002",
      "simple": { "limit": 20, "period": 60 },
    },
  ],
  "vars": {
    "APP_URL": "https://scr-community.dk-rp.workers.dev",
    "ADMIN_DISCORD_IDS": "",
    "ADMIN_EMAILS": "",
    "DISCORD_GUILD_ID": "1177621426321244250",
    "INFINITEPAY_HANDLE": "razielrv7",
  },
  "triggers": { "crons": ["0 6 * * *"] },
}
